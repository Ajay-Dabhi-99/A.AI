# A.ai environment variables. Names only: never commit real values.
# Copy to `.env` in the repository root. The API, Prisma and the Vite dev
# server all read this one file; only VITE_-prefixed values reach the browser.
# Required infrastructure (blueprint v4): Supabase PostgreSQL + Upstash Redis.
# Docker is not used.

# ---- API runtime (server-only) ----------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Supabase PostgreSQL (required) -----------------------------------------
# Supabase dashboard -> Connect -> ORMs / connection string.
# DATABASE_URL: pooled connection (Supavisor, port 6543) used by the running API.
DATABASE_URL=
# DIRECT_URL: direct connection (port 5432) used by `prisma migrate`.
DIRECT_URL=

# ---- Upstash Redis (required) -----------------------------------------------
# Upstash console -> your database -> "Connect" -> TCP (ioredis). Must be rediss:// (TLS).
REDIS_URL=

# ---- Auth (required) ----------------------------------------------------------
# At least 32 random characters. Used to sign cookies and to hash session and
# email-link tokens, so rotating it signs everyone out and invalidates open links.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Browser access (required) ------------------------------------------------
# Exact frontend origin(s) allowed by CORS, comma-separated, no trailing path.
CORS_ORIGIN=http://localhost:5180
# Origin used in links inside emails. Defaults to the first CORS_ORIGIN.
APP_URL=

# ---- Guest mode and quotas ---------------------------------------------------------
GUEST_SESSION_TTL_MINUTES=1440
GUEST_DAILY_MESSAGE_LIMIT=20
USER_DAILY_MESSAGE_LIMIT=200
# Models one comparison may run (2 to 4). Each model uses one message of the daily allowance.
GUEST_COMPARE_MAX_MODELS=2
USER_COMPARE_MAX_MODELS=4

# ---- Context management -----------------------------------------------------------
# When a chat outgrows the model's context window, the same model writes a summary of the
# older messages in the background (one extra provider call; not charged to the user).
# Set to false to only trim old messages.
CONTEXT_SUMMARY_ENABLED=true

# ---- Retries and fallback ------------------------------------------------------------
# When the chosen chat model fails before sending any text, it is retried once for transient
# errors and then another healthy model answers, labelled in the reply. false = retry only.
CHAT_FALLBACK_ENABLED=true

# ---- Email (verification + password reset) -----------------------------------------
# Resend (https://resend.com): API Keys -> Create. Required in production.
# Leave empty in development: emails, including their links, are written to the API log.
RESEND_API_KEY=
# Must use a domain verified in Resend. `onboarding@resend.dev` only delivers to your own Resend account email.
EMAIL_FROM=A.ai <onboarding@resend.dev>

# ---- Image uploads (Supabase Storage) -----------------------------------------------
# Supabase dashboard -> Project Settings -> API. The service-role key is server-side only.
# Create a PRIVATE bucket with the name below. Leave both empty to disable image uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=a-ai-attachments
# Largest accepted image, in bytes (default 5 MiB).
ATTACHMENT_MAX_BYTES=5242880
# Largest generated video stored in the same bucket (default 50 MiB). No video provider is enabled:
# none of the supported providers offers free video generation (checked 2026-09-17).
VIDEO_MAX_BYTES=52428800

# ---- Image generation (Cloudflare Workers AI) ------------------------------------------
# Free: the Workers Free plan includes 10,000 neurons a day, about 170 FLUX.1 [schnell] images.
# dash.cloudflare.com -> Workers AI -> "Use REST API": copy the Account ID and create an API token
# with the "Workers AI: Read" and "Workers AI: Edit" permissions. Set both or neither.
# Image generation also needs the Supabase Storage bucket above.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# ---- Voice input (speech-to-text) ---------------------------------------------------
# Uses Groq Whisper through GROQ_API_KEY below. Without that key the microphone button is hidden.
# Recordings are transcribed and discarded; they are never stored. Read-aloud uses the browser.
AUDIO_MAX_BYTES=10485760

# ---- Production hosting (ADR-017) -----------------------------------------------------
# Proxies in front of the API whose X-Forwarded-For is trusted for the client address.
# Leave empty: 1 in production (Render), 0 elsewhere. Never set it higher than the real hops.
TRUST_PROXY_HOPS=
# Sentry error reports (sentry.io -> project -> Client Keys). Empty sends nothing.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Set automatically by Render; shown by GET /health so the smoke test can confirm a deploy.
RENDER_GIT_COMMIT=

# ---- AI providers (at least one required for readiness) ------------------------
# A provider without a key is disabled, never faked.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Web (Vite) ------------------------------------------------------------------
# Leave VITE_API_URL empty in development: the Vite dev server proxies /api,
# /health and /ready to API_PROXY_TARGET so cookies stay same-origin.
VITE_API_URL=
API_PROXY_TARGET=http://localhost:4000
# Browser error reports (a Sentry DSN is public by design). Empty sends nothing.
VITE_SENTRY_DSN=

# ---- Release smoke test (`pnpm smoke`) ---------------------------------------------
# Deployed API and web origins, used when --api / --web are not given.
SMOKE_API_URL=
SMOKE_WEB_ORIGIN=

# ---- Live infrastructure tests (`pnpm test:live`) ---------------------------------
# Point at a separate Supabase project/branch and Upstash database, never production.
TEST_DATABASE_URL=
# Direct (port 5432) URL of the same test project, used to apply migrations before the suite.
TEST_DIRECT_URL=
TEST_REDIS_URL=
