{
  "name": "a-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A.ai: multi-model AI workspace and comparison platform",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@a-ai/api --filter=@a-ai/web",
    "dev:api": "pnpm --filter @a-ai/api dev",
    "dev:web": "pnpm --filter @a-ai/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:live": "turbo run test:live --concurrency=1",
    "check:env": "tsx scripts/check-env.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/node": "26.5.1",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "zod": "4.6.4"
  }
}
