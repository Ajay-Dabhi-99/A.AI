{
  "name": "@a-ai/api",
  "version": "0.1.0",
  "private": true,
  "description": "A.ai Fastify API gateway",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=@a-ai/source src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@node-rs/argon2": "2.2.1",
    "@fastify/helmet": "13.1.1",
    "@a-ai/ai-core": "workspace:*",
    "@a-ai/ai-providers": "workspace:*",
    "@a-ai/config": "workspace:*",
    "@a-ai/shared-types": "workspace:*",
    "@a-ai/validation": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.4",
    "ioredis": "5.11.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/ioredis-mock": "8.2.8",
    "@types/node": "26.5.1",
    "ioredis-mock": "8.13.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
