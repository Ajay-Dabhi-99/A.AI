// A.ai database schema (Supabase PostgreSQL).
// Every table created here must have Row Level Security enabled in its
// migration (ADR-005): Supabase exposes the public schema through its Data API.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// An account. Emails are stored lowercased and trimmed.
model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(254)
  passwordHash    String
  /// Optional profile details; null until the account fills them in.
  firstName       String?        @db.VarChar(60)
  lastName        String?        @db.VarChar(60)
  phone           String?        @db.VarChar(24)
  /// Up to three topics the user picked after signing in (MODEL-066).
  interests       String[]       @default([]) @db.VarChar(40)
  /// When the topics were last saved (also when skipped); null until the user answers.
  interestsSetAt  DateTime?      @db.Timestamptz(3)
  /// Personal instructions sent with every chat while enabled (MODEL-069).
  instructionsAbout   String?    @db.VarChar(1500)
  instructionsStyle   String?    @db.VarChar(1500)
  instructionsEnabled Boolean    @default(true)
  role            UserRole       @default(USER)
  emailVerifiedAt DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  authTokens      AuthToken[]
  conversations   Conversation[]
  comparisons     Comparison[]
  attachments     Attachment[]
  generationJobs  GenerationJob[]
  shares          ConversationShare[]

  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its HMAC is stored,
/// so a database leak cannot be replayed as a login.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?   @db.VarChar(512)
  ipHash     String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

/// Single-use links sent by email. Only the HMAC of the token is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @db.VarChar(64)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// A saved chat. Guests never get rows here; their chat lives in Redis until
/// migrated after signup, which sets guestMigrationKey so a retry cannot duplicate it.
model Conversation {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  title             String     @db.VarChar(120)
  guestMigrationKey String?    @unique @db.VarChar(64)
  /// Running summary of the messages up to summaryUpToMessageId (Phase 5, ADR-012). Null until
  /// the conversation outgrows the model's context window.
  summary              String?   @db.Text
  summaryUpToMessageId String?   @db.Uuid
  summaryUpdatedAt     DateTime? @db.Timestamptz(3)
  /// Set while the owner keeps the chat at the top of the sidebar (MODEL-062).
  pinnedAt          DateTime?  @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  runs              ModelRun[]
  /// Images created from this chat (MODEL-065).
  generationJobs    GenerationJob[]
  /// Public read-only snapshot, when the owner shared the chat (MODEL-070).
  share             ConversationShare?

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

/// A public, read-only snapshot of a chat (MODEL-070). Anyone with the token can
/// read `messages`; later messages stay private until the owner updates the share.
model ConversationShare {
  id             String       @id @default(uuid()) @db.Uuid
  /// 32 random bytes, base64url: the only thing a reader needs.
  token          String       @unique @db.VarChar(64)
  conversationId String       @unique @db.Uuid
  userId         String       @db.Uuid
  title          String       @db.VarChar(120)
  /// Text only: [{ role, content, model }]. Images and instructions are never included.
  messages       Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("conversation_shares")
}

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            ModelRun?
  attachments    Attachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// An image the user uploaded or a job generated (Phase 8, ADR-015). The bytes are in
/// private object storage at storageKey; only the owner reads them, through signed URLs.
/// messageId is null until the image is sent with a message.
model Attachment {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  messageId  String?        @db.Uuid
  kind       String         @default("image") @db.VarChar(16)
  source     String         @default("upload") @db.VarChar(16)
  mimeType   String         @db.VarChar(32)
  sizeBytes  Int
  /// Null for videos (Phase 9): their headers are not parsed.
  width      Int?
  height     Int?
  sha256     String         @db.VarChar(64)
  fileName   String?        @db.VarChar(120)
  storageKey String         @unique @db.VarChar(200)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  attachedAt DateTime?      @db.Timestamptz(3)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  job        GenerationJob?

  @@index([userId, createdAt(sort: Desc)])
  @@index([messageId])
  @@map("attachments")
}

enum GenerationJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED

  @@map("generation_job_status")
}

/// An asynchronous image generation (Phase 8, ADR-015 §6). The result is an attachment.
model GenerationJob {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  kind         String              @default("image") @db.VarChar(16)
  provider     String              @db.VarChar(32)
  model        String              @db.VarChar(128)
  prompt       String              @db.Text
  status       GenerationJobStatus @default(QUEUED)
  errorCode    String?             @db.VarChar(64)
  attachmentId String?             @unique @db.Uuid
  /// The chat the job was started from; null for jobs started elsewhere (MODEL-065).
  conversationId String?           @db.Uuid
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?           @db.Timestamptz(3)
  completedAt  DateTime?           @db.Timestamptz(3)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment   Attachment?         @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  conversation Conversation?       @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Recent jobs per kind (Phase 9 job list and resume after refresh).
  @@index([userId, kind, createdAt(sort: Desc)])
  @@index([status, createdAt])
  /// A chat's images in order (MODEL-065).
  @@index([conversationId, createdAt])
  @@map("generation_jobs")
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT

  @@map("run_status")
}

/// One provider call (blueprint §8 model_runs). A failed run with no output has no message.
model ModelRun {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  messageId        String?      @unique @db.Uuid
  provider         String       @db.VarChar(32)
  model            String       @db.VarChar(128)
  status           RunStatus    @default(RUNNING)
  ttftMs           Int?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  usageSource      String?      @db.VarChar(16)
  estimatedCostUsd Decimal?     @db.Decimal(12, 6)
  errorCode        String?      @db.VarChar(64)
  /// The model the user chose, when a fallback model answered (Phase 6, ADR-013).
  requestedProvider String?     @db.VarChar(32)
  requestedModel    String?     @db.VarChar(128)
  /// Provider calls made for this run, including retries and fallbacks.
  attemptCount      Int         @default(1)
  /// Error code that made the run switch to another model.
  fallbackReason    String?     @db.VarChar(64)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?    @db.Timestamptz(3)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  /// Deployment-wide usage ranges (Phase 7, ADR-014).
  @@index([createdAt])
  @@map("model_runs")
}

/// One prompt answered by several models side by side (Phase 4, ADR-011). Users only:
/// a guest's comparison prompt lives in Redis until the guest session expires.
model Comparison {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  prompt    String          @db.Text
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      ComparisonRun[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("comparisons")
}

/// One model's answer in a comparison. `position` is the order runs were started
/// (request order, then retries). A retry adds a run; the failed one keeps its outcome.
model ComparisonRun {
  id               String     @id @default(uuid()) @db.Uuid
  comparisonId     String     @db.Uuid
  position         Int
  provider         String     @db.VarChar(32)
  model            String     @db.VarChar(128)
  status           RunStatus  @default(RUNNING)
  /// The answer. Null after a failure (partial output is discarded) or when nothing was produced.
  content          String?    @db.Text
  ttftMs           Int?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  usageSource      String?    @db.VarChar(16)
  estimatedCostUsd Decimal?   @db.Decimal(12, 6)
  errorCode        String?    @db.VarChar(64)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?  @db.Timestamptz(3)
  comparison       Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId, position])
  /// Deployment-wide usage ranges (Phase 7, ADR-014).
  @@index([createdAt])
  @@map("comparison_runs")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

/// The models this deployment offers (Phase 3, ADR-010). Admins edit rows
/// without a deploy; catalog defaults that are missing are inserted on first load.
/// verifiedAt is set only after the limits were confirmed with a real provider key.
model ModelRegistryEntry {
  id                       String    @id @default(uuid()) @db.Uuid
  provider                 String    @db.VarChar(32)
  modelId                  String    @db.VarChar(128)
  name                     String    @db.VarChar(120)
  category                 String    @default("text") @db.VarChar(16)
  contextWindow            Int
  maxOutputTokens          Int
  supportsStreaming        Boolean   @default(true)
  supportsVision           Boolean   @default(false)
  supportsTools            Boolean   @default(false)
  availability             String    @db.VarChar(16)
  enabled                  Boolean   @default(true)
  sortOrder                Int       @default(100)
  inputPricePerMillionUsd  Decimal?  @db.Decimal(12, 6)
  outputPricePerMillionUsd Decimal?  @db.Decimal(12, 6)
  verifiedAt               DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, modelId])
  @@index([enabled, sortOrder])
  @@map("model_registry")
}
