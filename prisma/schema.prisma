// A.ai database schema (Supabase PostgreSQL).
// Every table created here must have Row Level Security enabled in its
// migration (ADR-005): Supabase exposes the public schema through its Data API.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// An account. Emails are stored lowercased and trimmed.
model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(254)
  passwordHash    String
  role            UserRole       @default(USER)
  emailVerifiedAt DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  sessions        Session[]
  authTokens      AuthToken[]
  conversations   Conversation[]
  comparisons     Comparison[]

  @@map("users")
}

/// A signed-in browser. The cookie holds a random token; only its HMAC is stored,
/// so a database leak cannot be replayed as a login.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?   @db.VarChar(512)
  ipHash     String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

/// Single-use links sent by email. Only the HMAC of the token is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @db.VarChar(64)
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// A saved chat. Guests never get rows here; their chat lives in Redis until
/// migrated after signup, which sets guestMigrationKey so a retry cannot duplicate it.
model Conversation {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  title             String     @db.VarChar(120)
  guestMigrationKey String?    @unique @db.VarChar(64)
  /// Running summary of the messages up to summaryUpToMessageId (Phase 5, ADR-012). Null until
  /// the conversation outgrows the model's context window.
  summary              String?   @db.Text
  summaryUpToMessageId String?   @db.Uuid
  summaryUpdatedAt     DateTime? @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(3)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          Message[]
  runs              ModelRun[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            ModelRun?

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT

  @@map("run_status")
}

/// One provider call (blueprint §8 model_runs). A failed run with no output has no message.
model ModelRun {
  id               String       @id @default(uuid()) @db.Uuid
  conversationId   String       @db.Uuid
  messageId        String?      @unique @db.Uuid
  provider         String       @db.VarChar(32)
  model            String       @db.VarChar(128)
  status           RunStatus    @default(RUNNING)
  ttftMs           Int?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  usageSource      String?      @db.VarChar(16)
  estimatedCostUsd Decimal?     @db.Decimal(12, 6)
  errorCode        String?      @db.VarChar(64)
  /// The model the user chose, when a fallback model answered (Phase 6, ADR-013).
  requestedProvider String?     @db.VarChar(32)
  requestedModel    String?     @db.VarChar(128)
  /// Provider calls made for this run, including retries and fallbacks.
  attemptCount      Int         @default(1)
  /// Error code that made the run switch to another model.
  fallbackReason    String?     @db.VarChar(64)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?    @db.Timestamptz(3)
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message          Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  /// Deployment-wide usage ranges (Phase 7, ADR-014).
  @@index([createdAt])
  @@map("model_runs")
}

/// One prompt answered by several models side by side (Phase 4, ADR-011). Users only:
/// a guest's comparison prompt lives in Redis until the guest session expires.
model Comparison {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  prompt    String          @db.Text
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      ComparisonRun[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("comparisons")
}

/// One model's answer in a comparison. `position` is the order runs were started
/// (request order, then retries). A retry adds a run; the failed one keeps its outcome.
model ComparisonRun {
  id               String     @id @default(uuid()) @db.Uuid
  comparisonId     String     @db.Uuid
  position         Int
  provider         String     @db.VarChar(32)
  model            String     @db.VarChar(128)
  status           RunStatus  @default(RUNNING)
  /// The answer. Null after a failure (partial output is discarded) or when nothing was produced.
  content          String?    @db.Text
  ttftMs           Int?
  latencyMs        Int?
  inputTokens      Int?
  outputTokens     Int?
  usageSource      String?    @db.VarChar(16)
  estimatedCostUsd Decimal?   @db.Decimal(12, 6)
  errorCode        String?    @db.VarChar(64)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?  @db.Timestamptz(3)
  comparison       Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId, position])
  /// Deployment-wide usage ranges (Phase 7, ADR-014).
  @@index([createdAt])
  @@map("comparison_runs")
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

/// The models this deployment offers (Phase 3, ADR-010). Admins edit rows
/// without a deploy; catalog defaults that are missing are inserted on first load.
/// verifiedAt is set only after the limits were confirmed with a real provider key.
model ModelRegistryEntry {
  id                       String    @id @default(uuid()) @db.Uuid
  provider                 String    @db.VarChar(32)
  modelId                  String    @db.VarChar(128)
  name                     String    @db.VarChar(120)
  category                 String    @default("text") @db.VarChar(16)
  contextWindow            Int
  maxOutputTokens          Int
  supportsStreaming        Boolean   @default(true)
  supportsVision           Boolean   @default(false)
  supportsTools            Boolean   @default(false)
  availability             String    @db.VarChar(16)
  enabled                  Boolean   @default(true)
  sortOrder                Int       @default(100)
  inputPricePerMillionUsd  Decimal?  @db.Decimal(12, 6)
  outputPricePerMillionUsd Decimal?  @db.Decimal(12, 6)
  verifiedAt               DateTime? @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, modelId])
  @@index([enabled, sortOrder])
  @@map("model_registry")
}
