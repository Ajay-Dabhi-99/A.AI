{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["packages/config/tsconfig*.json"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "TEST_DATABASE_URL",
    "TEST_DIRECT_URL",
    "TEST_REDIS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "outputs": []
    },
    "test:live": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
